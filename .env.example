# TinaCMS — solo hacen falta para editar en producción (/admin desplegado).
# En local, `pnpm dev` levanta el backend sobre los archivos del repo sin ellas.
# Se sacan de https://app.tina.io tras crear el proyecto.
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
# Rama sobre la que Tina Cloud guarda los cambios (por defecto: master).
TINA_BRANCH=
