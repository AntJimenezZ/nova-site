    'Web Development',
    'Mobile Apps',
    'UI/UX Design',
    'E-commerce',
    'Cloud Solutions',
    'API Development'
  ];

  // Initialize tech labels and fade states
  useEffect(() => {
    if (techIcons.length > 0 && randomIdeas.length > 0) {
      setTechLabels(techIcons.map(() => randomIdeas[0]));
      setTechFade(techIcons.map(() => true));
    }
  }, [techIcons.length, randomIdeas.length]);

  // Sample projects data
  const projects: Project[] = [
    {
      id: '1',
      title: 'E-commerce Platform',
      description: 'A full-featured e-commerce platform with payment integration',
      image: '/path/to/project1.jpg',
      technologies: ['React', 'Node.js', 'MongoDB'],
      tech: ['React', 'Node.js', 'MongoDB', 'Stripe']
    },
    {
      id: '2',
      title: 'Portfolio Website',
      description: 'A modern portfolio website with animations',
      image: '/path/to/project2.jpg',
      technologies: ['Next.js', 'TypeScript', 'Tailwind CSS'],
      tech: ['Next.js', 'TypeScript', 'Tailwind CSS', 'Framer Motion']
    }
  ];

  // Sample services data
  const services = [
    {
      id: '1',
      title: 'Web Development',
      description: 'Custom web applications built with modern technologies',
      icon: 'code'
    },
    {
      id: '2',
      title: 'E-commerce',
      description: 'Online stores with secure payment integration',
      icon: 'shopping-cart'
    },
    {
      id: '3',
      title: 'Maintenance',
      description: 'Ongoing support and updates for your website',
      icon: 'settings'
    }
  ];

  // Sample testimonials data
  const testimonials: Testimonial[] = [
    {
      id: '1',
      name: 'John Doe',
      role: 'CEO',
      company: 'Tech Corp',
      image: '/path/to/avatar1.jpg',
      rating: 5,
      content: 'Excellent work! The team delivered beyond our expectations.',
      date: '2024-02-15',
      projectTitle: 'E-commerce Platform'
    }
  ];

  // Sample team data with all required properties
  const team: TeamMember[] = [
    {
      id: '1',
      name: 'John Doe',
      role: 'Full Stack Developer',
      image: '/path/to/image.jpg',
      avatar: '/path/to/avatar.jpg',
      description: 'Experienced developer with 5+ years in web development',
      skills: ['React', 'Node.js', 'TypeScript'],
      technologies: ['JavaScript', 'Python', 'Docker'],
      experience: ['5+ years of experience'],
      education: ['Computer Science Degree'],
      achievements: ['Led team of 5 developers', 'Delivered 10+ projects']
    }
  ];

  // Form handlers
  const handleInputChange = (e: React.ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => {
    const { name, value } = e.target;
    setFormData((prev: any) => ({
      ...prev,
      [name]: value
    }));
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setIsSubmitting(true);
    
    try {
      // TODO: Implement form submission logic
      setSubmitStatus({ success: true, message: 'Message sent successfully!' });
      setFormData({ name: '', email: '', subject: '', message: '' });
    } catch (error) {
      setSubmitStatus({ success: false, message: 'Failed to send message. Please try again.' });
    } finally {
      setIsSubmitting(false);
    }
  };

  // Touch event handlers for mobile swipe
  const handleTouchStart = (e: React.TouchEvent) => {
    setTouchStartX(e.touches[0].clientX);
  };

  const handleTouchMove = (e: React.TouchEvent) => {
    if (!touchStartX) return;
    
    const touchX = e.touches[0].clientX;
    const diff = touchStartX - touchX;
    
    if (Math.abs(diff) > 50) { // Minimum swipe distance
      if (diff > 0) {
        nextProject(); // Swipe left
      } else {
        prevProject(); // Swipe right
      }
      setTouchStartX(null);
    }
  };

  // Toast function
  const pushToast = (type: "success" | "error" | "info", message: string) => {
    setToast({ type, message });
    setTimeout(() => setToast(null), 4000);
  };

  // Sample team data with all required properties
  const team: TeamMember[] = [
    {
      id: '1',
      name: 'John Doe',
      role: 'Full Stack Developer',
      image: '/path/to/image.jpg',
      avatar: '/path/to/avatar.jpg',
      description: 'Experienced developer with 5+ years in web development',
      skills: ['React', 'Node.js', 'TypeScript'],
      technologies: ['JavaScript', 'Python', 'Docker'],
      experience: ['5+ years of experience'],
      education: ['Computer Science Degree'],
