  const portfolioAutoRef = useRef<HTMLDivElement>(null);
  const contactRef = useRef<HTMLElement>(null);

  // Project navigation functions
  const goToNextProject = () => {
    setTransitionDir('next');
    setProjectTransition(true);
    setTimeout(() => {
      setCurrentProject((prev) => (prev + 1) % projects.length);
      setProjectTransition(false);
    }, 300);
  };

  const goToPrevProject = () => {
    setTransitionDir('prev');
    setProjectTransition(true);
    setTimeout(() => {
      setCurrentProject((prev) => (prev - 1 + projects.length) % projects.length);
      setProjectTransition(false);
    }, 300);
  };

  // Alias functions for consistency
  const prevProject = goToPrevProject;
  const nextProject = goToNextProject;

  // Tech icons for the hero section
  const techIcons: TechIcon[] = [
    { name: 'React', icon: <Code2 className="w-6 h-6" /> },
    { name: 'Next.js', icon: <Code2 className="w-6 h-6" /> },
    { name: 'TypeScript', icon: <Code2 className="w-6 h-6" /> },
    { name: 'Node.js', icon: <Code2 className="w-6 h-6" /> },
  ];

