// Define types
interface Toast {
  type: 'success' | 'error' | 'info';
  message: string;
}

interface TeamMember {
  id?: string;
  name: string;
  role: string;
  image: string;
  avatar?: string;
  description: string;
  skills: string[];
  experience?: string[];
  education?: string[];
  technologies?: string[];
  achievements?: string[];
}

interface Project {
  id: string;
  title: string;
  description: string;
  image: string;
  technologies: string[];
  tech?: string[];
}

interface Testimonial {
  id: string;
  name: string;
  role: string;
  company: string;
  image: string;
  rating: number;
  content: string;
  date: string;
  projectTitle?: string;
  comment?: string;
}

interface TechIcon {
  name: string;
  icon: React.ReactNode;
}

const Home = (): JSX.Element => {
  // State management
  const [toast, setToast] = useState<Toast | null>(null);
  const [currentProject, setCurrentProject] = useState(0);
  const [techLabels, setTechLabels] = useState<string[]>([]);
  const [techFade, setTechFade] = useState<boolean[]>([]);
  const [openMember, setOpenMember] = useState<number | null>(null);
  const [projectTransition, setProjectTransition] = useState(false);
  const [transitionDir, setTransitionDir] = useState<'next' | 'prev'>('next');
  const [testimonialsVisible, setTestimonialsVisible] = useState(false);
  const [servicesVisible, setServicesVisible] = useState(false);
  const [teamVisible, setTeamVisible] = useState(false);
  const [portfolioVisible, setPortfolioVisible] = useState(false);
  const [contactVisible, setContactVisible] = useState(false);
  const [isPaused, setIsPaused] = useState(false);
  const [touchStartX, setTouchStartX] = useState<number | null>(null);
  const [formData, setFormData] = useState({
    name: '',
    email: '',
    subject: '',
    message: ''
  });
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [submitStatus, setSubmitStatus] = useState<{success: boolean, message: string} | null>(null);
  
  // Refs with proper typing
