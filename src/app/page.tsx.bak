                  </a>
                </li>
                <li>
                  <a href="#" className="hover:text-white transition-colors">
                    Contacto
                  </a>
                </li>
              </ul>
            </div>

            <div>
              <h4 className="font-semibold mb-4">Contacto</h4>
              <ul className="space-y-2 text-slate-400">
                <li>contacto@novacr.site</li>
                <li>+(506) 8304-7436</li>
                <li>Costa Rica, Alajuela</li>
              </ul>
