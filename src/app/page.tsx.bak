  ];

  // Sample projects data
  const projects: Project[] = [
    {
      id: '1',
      title: 'E-commerce Platform',
      description: 'A full-featured e-commerce platform with payment integration',
      image: '/path/to/project1.jpg',
      technologies: ['React', 'Node.js', 'MongoDB'],
      tech: ['React', 'Node.js', 'MongoDB', 'Stripe']
    },
    {
      id: '2',
      title: 'Portfolio Website',
      description: 'A modern portfolio website with animations',
      image: '/path/to/project2.jpg',
      technologies: ['Next.js', 'TypeScript', 'Tailwind CSS'],
      tech: ['Next.js', 'TypeScript', 'Tailwind CSS', 'Framer Motion']
    },
    // Add more projects as needed
  ];

  const services = [
    {
      id: '1',
      title: 'Web Development',
      description: 'Custom web applications',
      icon: 'code'
    }
    // Add more services as needed
  ];

  const techIcons: TechIcon[] = [
    { name: 'React', icon: <Code2 className="w-6 h-6" /> },
    { name: 'Next.js', icon: <Code2 className="w-6 h-6" /> },
    { name: 'TypeScript', icon: <Code2 className="w-6 h-6" /> },
    { name: 'Tailwind', icon: <Code2 className="w-6 h-6" /> },
    { name: 'Node.js', icon: <Code2 className="w-6 h-6" /> },
  ];
  
  // Initialize tech labels and fade states
  useEffect(() => {
    if (techIcons.length > 0) {
      setTechLabels(techIcons.map(() => ''));
